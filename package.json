{
  "name": "rag-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/python-agents.sh cleanup && concurrently -k -n \"next,studio,agents\" -c \"cyan,magenta,yellow\" \"next dev\" \"bash scripts/remotion-safe.sh\" \"bash scripts/python-agents.sh\"",
    "dev:next": "next dev",
    "dev:no-agents": "concurrently -n \"next,studio\" -c \"cyan,magenta\" \"next dev\" \"bash scripts/remotion-safe.sh\"",
    "agents:start": "bash scripts/python-agents.sh start",
    "agents:stop": "bash scripts/python-agents.sh stop",
    "build": "next build",
    "start": "concurrently -n \"next,studio\" -c \"cyan,magenta\" \"next start\" \"bash scripts/remotion-safe.sh\"",
    "start:next": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "remotion": "remotion studio src/remotion/index.tsx",
    "remotion:render": "remotion render src/remotion/index.tsx HtmlSlideVideo out/video.mp4 --fps=60",
    "remotion:course": "bash scripts/remotion-studio.sh",
    "remotion:service": "bash scripts/start-remotion-service.sh",
    "remotion:service:start": "bash scripts/start-remotion-service.sh start",
    "remotion:service:stop": "bash scripts/start-remotion-service.sh stop",
    "remotion:service:status": "bash scripts/start-remotion-service.sh status",
    "ffmpeg:render": "npx tsx scripts/ffmpeg-render.ts"
